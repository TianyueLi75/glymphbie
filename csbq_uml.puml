' Assume all given in discretized way.
' SetInnerSEL, SetOuterSEL : Creates SlenderElemList with inner_Xc and inner_R (or outer_), input = Elemorder, FourierOrder.
'                           This should set inner_coord, outer_coord, and later the elem_dsp too.
' aspect_ratio should be calculated at construction, and whenever new innerXc is added.
' I plan to simply append the two tubes, but this function abstracts that away.
class Annular {
    - inner_Xc
    - outer_Xc
    - inner_radius
    - outer_radius
    - inner_coord 
    - outer_coord 
    - aspect_rat

    constructor() 
    destructor()

    SetInnerXc()
    SetOuterXc()
    SetInnerR()
    SetOuterR()
    SetInnerSEL() 
    SetOuterSEL() 
    GetInnerCoord()
    GetOuterCoord()
    GetCoord()
    GetAspectRatio()
}

